# Copy this file to .env and adjust values for your environment.

# Database
# Set to 'true' to use PostgreSQL, 'false' for SQLite.
USE_POSTGRES=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ml_pipeline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Service ports
INGESTION_API_PORT=8001
PREDICTION_SERVICE_PORT=8002
DASHBOARD_PORT=8050

# MLFlow
MLFLOW_TRACKING_URI=file:./mlruns

# Security
# Required header `X-API-Key: <value>` on all POST endpoints when set.
# Leave blank to disable auth (dev only).
API_KEY=
# Comma-separated origins allowed by CORS, or blank to deny all.
CORS_ORIGINS=
# Bind to 127.0.0.1 for local-only; 0.0.0.0 only with API_KEY set.
BIND_HOST=127.0.0.1

# Request limits
MAX_CONTENT_LENGTH=10485760
MAX_BATCH_ROWS=10000
MAX_PREDICT_ROWS=1000

# WSGI threads and Postgres pool size
WAITRESS_THREADS=8
PG_POOL_MIN=1
PG_POOL_MAX=10

# Keep this many trained .pkl files; older ones are rotated out.
KEEP_N_MODELS=5
