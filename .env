# Database Configuration
# Set to 'true' to use PostgreSQL, 'false' to use SQLite
USE_POSTGRES=true

# PostgreSQL Configuration (only used if USE_POSTGRES=true)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ml_pipeline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=data

# Service Configuration
INGESTION_API_PORT=8001
PREDICTION_SERVICE_PORT=8002
DASHBOARD_PORT=8050

# MLFlow Configuration
MLFLOW_TRACKING_URI=file:./mlruns

# Security
# Leave API_KEY blank to disable auth (dev mode); set for production.
API_KEY=
# Comma-separated allowed CORS origins, or blank to deny all browser cross-origin.
CORS_ORIGINS=
# Bind address for service WSGI servers (127.0.0.1 = local only).
BIND_HOST=127.0.0.1

# Request limits
MAX_CONTENT_LENGTH=10485760
MAX_BATCH_ROWS=10000
MAX_PREDICT_ROWS=1000

# WSGI / pool
WAITRESS_THREADS=8
PG_POOL_MIN=1
PG_POOL_MAX=10

# Model lifecycle
KEEP_N_MODELS=5
